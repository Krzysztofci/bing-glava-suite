#!/bin/bash
# =============================================================================
# glava-colors-auto
# Analizuje aktualną tapetę Bing algorytmem KMeans (3 klastry), wyciąga
# dominujące kolory i wpisuje je do aktywnego fragmentu shadera GLava.
# Obsługuje moduły: graph, bars, circle, wave, radial.
# Zachowuje aktywny tryb gradientu (rgb/hsv) z gui_settings.json.
# =============================================================================

export DISPLAY=:0
export PATH=/usr/bin:/bin:/usr/local/bin

CONFIG="$HOME/.config/glava"
WALLPAPER="$HOME/Pictures/Bing/bing_today.jpg"
ACTIVE_MODULE_FILE="$CONFIG/active_module"
SETTINGS_FILE="$CONFIG/gui_settings.json"

mkdir -p "$CONFIG"

# Odczytaj aktywny moduł (domyślnie graph)
ACTIVE_MODULE="graph"
if [ -f "$ACTIVE_MODULE_FILE" ]; then
    ACTIVE_MODULE="$(cat "$ACTIVE_MODULE_FILE")"
fi

# Mapowanie modułu → szablon i plik docelowy
case "$ACTIVE_MODULE" in
    graph)  TEMPLATE="$CONFIG/graph_colors.frag";    LIVEFRAG="$CONFIG/graph/1.frag"  ;;
    bars)   TEMPLATE="$CONFIG/bars_colors.frag";   LIVEFRAG="$CONFIG/bars/1.frag"   ;;
    circle) TEMPLATE="$CONFIG/circle_colors.frag"; LIVEFRAG="$CONFIG/circle/1.frag" ;;
    wave)   TEMPLATE="$CONFIG/wave_colors.frag";   LIVEFRAG="$CONFIG/wave/1.frag"   ;;
    radial) TEMPLATE="$CONFIG/radial_colors.frag"; LIVEFRAG="$CONFIG/radial/1.frag" ;;
    *)
        echo "Nieznany moduł: $ACTIVE_MODULE, używam graph." >&2
        ACTIVE_MODULE="graph"
        TEMPLATE="$CONFIG/graph_colors.frag"
        LIVEFRAG="$CONFIG/graph/1.frag"
        ;;
esac

# Odczytaj tryb gradientu z gui_settings.json
GRADIENT_MODE=$(python3 -c "
import json, os, sys
f = '$SETTINGS_FILE'
try:
    d = json.load(open(f))
    print(d.get('gradient_mode', 'rgb'))
except:
    print('rgb')
" 2>/dev/null || echo "rgb")

# Wygeneruj kolory z tapety i zapisz do live frag
python3 - "$TEMPLATE" "$LIVEFRAG" "$GRADIENT_MODE" << 'PYEOF'
from PIL import Image
import numpy as np
from sklearn.cluster import KMeans
import os, sys, re

wallpaper     = os.path.expanduser(os.environ.get('HOME', '~') + '/Pictures/Bing/bing_today.jpg')
template_path = sys.argv[1]
live_path     = sys.argv[2]
gradient_mode = sys.argv[3] if len(sys.argv) > 3 else 'rgb'

if not os.path.exists(wallpaper):
    print("Brak pliku tapety: " + wallpaper, file=sys.stderr)
    sys.exit(1)

if not os.path.exists(template_path):
    print("Brak pliku szablonu: " + template_path, file=sys.stderr)
    sys.exit(1)

# Analiza kolorów KMeans
img = Image.open(wallpaper).convert('RGB')
img.thumbnail((200, 200))
pixels = np.array(img).reshape(-1, 3)
kmeans = KMeans(n_clusters=3, n_init=10)
kmeans.fit(pixels)
colors = sorted(kmeans.cluster_centers_.astype(int), key=lambda c: sum(c))

def vec3(rgb):
    return "vec3({:.2f}, {:.2f}, {:.2f})".format(rgb[0]/255, rgb[1]/255, rgb[2]/255)

# Wczytaj szablon i podmień kolory
with open(template_path) as f:
    lines = f.readlines()

os.makedirs(os.path.dirname(live_path), exist_ok=True)

with open(live_path, 'w') as f:
    for line in lines:
        if 'vec3 bottom' in line:
            f.write("vec3 bottom = {};\n".format(vec3(colors[0])))
        elif 'vec3 mid' in line:
            f.write("vec3 mid = {};\n".format(vec3(colors[1])))
        elif 'vec3 top' in line:
            f.write("vec3 top = {};\n".format(vec3(colors[2])))
        else:
            f.write(line)

# Podmień tryb gradientu (HSV_MODE 0/1)
with open(live_path) as f:
    src = f.read()
if '#define HSV_MODE' in src:
    hsv_val = '1' if gradient_mode == 'hsv' else '0'
    src = re.sub(r'#define HSV_MODE [01]', f'#define HSV_MODE {hsv_val}', src)
    with open(live_path, 'w') as f:
        f.write(src)

print("Kolory zaktualizowane ({}, gradient: {}).".format(
    os.path.basename(os.path.dirname(live_path)), gradient_mode))
PYEOF

# Usuń flagi trybu ręcznego
rm -f "$CONFIG/red.shift"
rm -f "$CONFIG/manual.shift"

# Ustaw aktywny moduł w rc.glsl
RC="$CONFIG/rc.glsl"
if [ -f "$RC" ]; then
    sed -i "s/^#request mod .*/#request mod $ACTIVE_MODULE/" "$RC"
fi

# Restart GLava
DISABLE_FLAG="$CONFIG/.glava_disabled"
pkill -x glava 2>/dev/null
sleep 0.2
if [ ! -f "$DISABLE_FLAG" ]; then
    glava --desktop >/dev/null 2>&1 &
fi
