#!/bin/bash
# =============================================================================
# glava-color-daemon
# Demon działający jako usługa systemd użytkownika. Nasłuchuje zmian pliku
# tapety Bing przez inotifywait i automatycznie aktualizuje kolory GLava.
#
# Flagi stanu:
#   red.shift      — tryb czerwony (ręczny preset), daemon nie nadpisuje kolorów
#   manual.shift   — tryb GUI (kolory ustawione ręcznie), daemon nie nadpisuje
#   .glava_disabled — GLava wyłączona przez użytkownika, demon jej nie uruchamia
# =============================================================================
DISABLE_FLAG="$HOME/.config/GlavaMP/.glava_disabled"
FLAG_RED="$HOME/.config/glava/red.shift"
FLAG_MANUAL="$HOME/.config/glava/manual.shift"
LOG="$HOME/.local/logs/glava-color-daemon.log"
WALLPAPER="$HOME/Pictures/Bing/bing_today.jpg"
GLAVA_DIR="$HOME/.config/glava"
BACKUP_DIR="$GLAVA_DIR/backup_frag"
LIVEFRAG="$GLAVA_DIR/graph/1.frag"

mkdir -p "$(dirname "$LOG")" "$BACKUP_DIR"

# --- Blokada wielu instancji ---
LOCKFILE="/tmp/glava-color-daemon-${USER}.lock"
if [ -e "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE")" 2>/dev/null; then
    echo "$(date '+%F %T') - Daemon już działa (PID $(cat "$LOCKFILE")), wychodzę." >> "$LOG"
    exit 0
fi
echo $$ > "$LOCKFILE"
INOTIFY_PID=""
cleanup() {
    rm -f "$LOCKFILE"
    [ -n "$INOTIFY_PID" ] && kill "$INOTIFY_PID" 2>/dev/null
    exit 0
}
trap cleanup SIGINT SIGTERM EXIT

# --- Uruchom GLava jeśli nie działa ---
# GUI zarządza instancjami przez instances.json:
if [ ! -f "$DISABLE_FLAG" ] && ! pgrep -x glava >/dev/null; then
    python3 "$HOME/.local/bin/glava-colors-auto-mi" >> "$LOG" 2>&1
    echo "$(date '+%F %T') - GLava uruchomiona przy starcie daemona." >> "$LOG"
fi

# --- Sprawdź czy tapeta jest nowsza niż shader (nadrobienie przegapionych zmian) ---
SHADER_TIME=$(stat -c "%Y" "$GLAVA_DIR/graph/1.frag" 2>/dev/null || echo 0)
WALLPAPER_TIME=$(stat -c "%Y" "$WALLPAPER" 2>/dev/null || echo 0)
if [ "$WALLPAPER_TIME" -gt "$SHADER_TIME" ]; then
    echo "$(date '+%F %T') - Tapeta nowsza niż shader, aktualizuję przy starcie." >> "$LOG"
    update_colors
fi

# --- Funkcja aktualizacji kolorów ---
update_colors() {
    # Blokada przed pętlą — ignoruj zdarzenia przez 5 sekund po aktualizacji
    LOCKFILE_UPDATE="/tmp/glava-update.lock"
    if [ -e "$LOCKFILE_UPDATE" ]; then
        return 0
    fi
    touch "$LOCKFILE_UPDATE"
    sleep 0.5
    rm -f "$LOCKFILE_UPDATE"

    # Tryb ręczny GUI — nie nadpisuj
    if [ -f "$FLAG_MANUAL" ]; then
        echo "$(date '+%F %T') - Tryb GUI aktywny, pomijam auto-update." >> "$LOG"
        return 0
    fi

    # Tryb czerwony — nie nadpisuj
    if [ -f "$FLAG_RED" ]; then
        echo "$(date '+%F %T') - Tryb RED aktywny, pomijam." >> "$LOG"
        return 0
    fi

    # Backup aktywnych shaderów (zachowaj ostatnie 20)
    TIMESTAMP=$(date '+%F_%H-%M-%S')
    for f in "$GLAVA_DIR"/graph/*.frag; do
        cp -u "$f" "$BACKUP_DIR/$(basename "$f").$TIMESTAMP.bak" 2>/dev/null
    done
    ls -t "$BACKUP_DIR"/*.bak 2>/dev/null | tail -n +21 | xargs -r rm --

    # Generuj nowe kolory z tapety
    python3 "$HOME/.local/bin/glava-colors-auto-mi" >> "$LOG" 2>&1
    echo "$(date '+%F %T') - GLava zaktualizowana." >> "$LOG"
}

# --- Sprawdź przy starcie czy tapeta jest nowsza niż shader ---
check_wallpaper_on_start() {
    if [ ! -f "$WALLPAPER" ]; then
        return 0
    fi
    if [ -f "$FLAG_MANUAL" ] || [ -f "$FLAG_RED" ]; then
        echo "$(date '+%F %T') - Tryb ręczny/RED aktywny przy starcie, pomijam sprawdzenie tapety." >> "$LOG"
        return 0
    fi
    WALLPAPER_TIME=$(stat -c "%Y" "$WALLPAPER" 2>/dev/null || echo 0)
    SHADER_TIME=$(stat -c "%Y" "$LIVEFRAG" 2>/dev/null || echo 0)
    if [ "$WALLPAPER_TIME" -gt "$SHADER_TIME" ]; then
        echo "$(date '+%F %T') - Tapeta nowsza niż shader — aktualizuję kolory przy starcie." >> "$LOG"
        update_colors
    fi
}

# --- Pętla główna: nasłuchuj zmian tapety ---
echo "$(date '+%F %T') - Daemon uruchomiony, obserwuję: $WALLPAPER" >> "$LOG"

check_wallpaper_on_start

while true; do
    inotifywait -e close_write,create,move "$WALLPAPER" >/dev/null 2>&1 &
    INOTIFY_PID=$!
    wait $INOTIFY_PID
    INOTIFY_PID=""
    sleep 0.2
    update_colors
done
